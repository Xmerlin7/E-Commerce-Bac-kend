PORT=8080
MONGO_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=

# Paymob (Intention API / Unified Checkout)
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
# Optional fallback if payment_methods is not sent in checkout request.
PAYMOB_INTEGRATION_ID=
PAYMOB_BASE_URL=https://accept.paymob.com/api
# Intention endpoint host (used for /v1/intention/)
PAYMOB_INTENTION_BASE_URL=https://accept.paymob.com
# Unified checkout page host. Egypt keys (egy_*) default to https://accept.paymob.com.
# Optional explicit override (wins over automatic profile):
# PAYMOB_UNIFIED_CHECKOUT_BASE_URL=https://accept.paymob.com
PAYMOB_PORTAL_BASE_URL=https://portal.paymob.com
PAYMENT_WEBHOOK_SECRET=
PAYMENT_PROVIDER_S2S_VERIFY_ENABLED=false
# Optional (default used when empty): /acceptance/transactions/:id
PAYMOB_VERIFY_TRANSACTION_ENDPOINT=
# Optional: front-end URL that Paymob redirects browser to after payment.
# For stable behavior, set PAYMOB_REDIRECTION_URL to backend return endpoint:
# Example: http://localhost:8080/api/payments/paymob/return
PAYMOB_REDIRECTION_URL=
# Front-end page that backend return endpoint redirects to.
# Example: http://localhost:4200/payment-result
FRONTEND_PAYMENT_RESULT_URL=
